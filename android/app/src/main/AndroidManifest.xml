<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No backup and no device transfer: message history stays on the device
         that received it (decision 0006), and the MLS state must never be
         restored elsewhere. allowBackup and fullBackupContent cover Android 11
         and older, dataExtractionRules Android 12 and later. -->
    <application
        android:name=".SpjallApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask: Kenni's redirect comes back while the Custom Tab sits
             above this activity, and must reach this instance (onNewIntent)
             rather than start a second one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The app's own scheme: Kenni's callback (is.samtak.spjall:/kenni)
                 and invite links opened from another app
                 (is.samtak.spjall://invite/<token>). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${urlScheme}" />
            </intent-filter>
            <!-- The invite link itself (decision 0019). It opens here once the
                 host serves assetlinks.json for the release signing key, and
                 in the browser until then. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${linkHost}" />
                <data android:pathPrefix="${linkPathPrefix}" />
            </intent-filter>
        </activity>
        <!-- Serves only the copies made to open a photo or file in another
             app (media/Files.kt), read-only and per grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>

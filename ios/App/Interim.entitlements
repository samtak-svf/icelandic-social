<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The interim TestFlight build (decision 0011): the App Group only. Push
     needs an APNs key, which 0010 keeps off the interim team. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SPJALL_APP_GROUP)</string>
	</array>
</dict>
</plist>

{
  "sourceLanguage": "is",
  "strings": {
    "app_name": {
      "comment": "Launcher label, home-screen name, store-facing display name.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjal"
          }
        }
      }
    },
    "tab_conversations": {
      "comment": "Bottom tab: the conversation list.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjal"
          }
        }
      }
    },
    "tab_me": {
      "comment": "Bottom tab: own profile, invite link and the way to settings (docs/decisions/0034).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég"
          }
        }
      }
    },
    "new_conversation": {
      "comment": "Action that starts a new conversation.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýtt hjal"
          }
        }
      }
    },
    "conversations_empty": {
      "comment": "The conversation list when there is none yet; points at the invite link (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin samtöl enn. Deildu hlekknum þínum til að hefja samtal."
          }
        }
      }
    },
    "conversations_search": {
      "comment": "Placeholder of the name search under the conversation list header; it finds conversations and people by the start of a name (docs/decisions/0038).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leita að nafni"
          }
        }
      }
    },
    "conversations_people": {
      "comment": "Heading over the people the conversation list's search found in the directory, below the conversations it found (docs/decisions/0036).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fólk"
          }
        }
      }
    },
    "conversations_none_found": {
      "comment": "The conversation list's search when neither a conversation nor a person matches it.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert samtal og enginn fannst með þessu nafni."
          }
        }
      }
    },
    "people_empty": {
      "comment": "The new-conversation picker when nobody else has signed in yet; points at the invite link (docs/decisions/0022, 0036).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enginn annar er kominn inn enn. Deildu hlekknum þínum til að bjóða fólki."
          }
        }
      }
    },
    "people_search": {
      "comment": "Placeholder of the name search at the top of the new-conversation picker (docs/decisions/0036).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leita að nafni"
          }
        }
      }
    },
    "people_none_found": {
      "comment": "The new-conversation picker when no signed-in account's name matches the search (docs/decisions/0036).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enginn fannst með þessu nafni."
          }
        }
      }
    },
    "people_met": {
      "comment": "Heading over the people met through shared conversations in the new-conversation picker.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fólk sem þú hefur spjallað við"
          }
        }
      }
    },
    "people_everyone": {
      "comment": "Heading over everyone else signed in, in the new-conversation picker (docs/decisions/0036).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allir aðrir"
          }
        }
      }
    },
    "connection_offline": {
      "comment": "Line on the conversation list while the app has no connection to the server (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert samband. Skilaboð berast þegar sambandið kemst aftur á."
          }
        }
      }
    },
    "connection_connecting": {
      "comment": "Line on the conversation list while the app reconnects.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengist…"
          }
        }
      }
    },
    "conversation_removed_banner": {
      "comment": "Banner in a conversation this account was removed from; the conversation is read-only (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú ert ekki lengur í þessu samtali."
          }
        }
      }
    },
    "conversation_alone_banner": {
      "comment": "Banner in a conversation no other account is in any more, as a 1:1 after a block; nothing can be sent there (docs/decisions/0024).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins þú ert eftir í þessu samtali."
          }
        }
      }
    },
    "conversation_alone_title": {
      "comment": "Title of a conversation no other account is in any more; a conversation is otherwise titled by its members (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins þú"
          }
        }
      }
    },
    "conversation_excluded_banner": {
      "comment": "Banner in a conversation the server refuses this device for; read-only until the next try (docs/decisions/0020, 0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki fær ekki aðgang að samtalinu eins og er. Reynt verður aftur."
          }
        }
      }
    },
    "conversation_stale_banner": {
      "comment": "Banner while this device rejoins a conversation it fell behind in (docs/decisions/0021, 0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalið er að tengjast aftur. Það gæti vantað skilaboð sem bárust á meðan."
          }
        }
      }
    },
    "contact_action": {
      "comment": "Button on an invite landing that opens a conversation with the inviter.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjala"
          }
        }
      }
    },
    "invite": {
      "comment": "Share your own invite link or QR code (docs/decisions/0009).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjóða"
          }
        }
      }
    },
    "composer_placeholder": {
      "comment": "Empty message composer.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifaðu skilaboð…"
          }
        }
      }
    },
    "send": {
      "comment": "Send button.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Senda"
          }
        }
      }
    },
    "message_sending": {
      "comment": "Status of an own message that is still being sent.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í sendingu"
          }
        }
      }
    },
    "message_failed": {
      "comment": "Status of an own message that could not be sent; the bubble offers try_again.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki send."
          }
        }
      }
    },
    "day_today": {
      "comment": "Day separator for today's messages.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í dag"
          }
        }
      }
    },
    "day_yesterday": {
      "comment": "Day separator for yesterday's messages.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í gær"
          }
        }
      }
    },
    "verified_with_kennitala": {
      "comment": "Badge on a person verified through Kenni.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vottað"
          }
        }
      }
    },
    "verified_short": {
      "comment": "Short form of verified_with_kennitala, under the other person's name at the top of a conversation.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vottað"
          }
        }
      }
    },
    "last_line_own": {
      "comment": "The conversation list's preview line when the newest message is the reader's own.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú: %1$@"
          }
        }
      }
    },
    "last_line_sender": {
      "comment": "The conversation list's preview line in a group when the newest message is someone else's; name is the sender's first name.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "unread_count": {
      "comment": "Unread messages in a conversation.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld ólesin"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld ólesin"
                }
              }
            }
          }
        }
      }
    },
    "push_fallback_body": {
      "comment": "Notification text when the device could not fetch what a push announced: the APNs alert the notification service extension keeps when it cannot decrypt in time, and Android's when its sync fails (docs/decisions/0025). Never names the sender.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ný skilaboð á Hjal"
          }
        }
      }
    },
    "notifications_off": {
      "comment": "Row on Ég when the system blocks the app's notifications: new messages are not announced until it is opened (docs/decisions/0025).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slökkt er á tilkynningum. Þú sérð ekki ný skilaboð fyrr en þú opnar appið."
          }
        }
      }
    },
    "notifications_settings": {
      "comment": "Action on the notifications_off row: opens the app's notification settings in the system.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opna stillingar"
          }
        }
      }
    },
    "new_device_card": {
      "comment": "System card in a conversation when a member adds a device (from an MLS add commit).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tengdi nýtt tæki."
          }
        }
      }
    },
    "member_added_card": {
      "comment": "System card when an account joins a group (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bættist í hópinn."
          }
        }
      }
    },
    "member_removed_card": {
      "comment": "System card when an account leaves a group, is removed, or deletes its account (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er ekki lengur í hópnum."
          }
        }
      }
    },
    "member_removed_card_direct": {
      "comment": "System card in a 1:1 when the other account leaves it, as on a block; member_removed_card says the same of a group (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er ekki lengur í samtalinu."
          }
        }
      }
    },
    "history_device_local_notice": {
      "comment": "Explains that a new device sees only messages sent after it joined (docs/decisions/0006).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ný tæki sjá aðeins skilaboð sem berast eftir að þau tengjast. Eldri skilaboð eru áfram á tækjunum sem tóku við þeim."
          }
        }
      }
    },
    "invite_link_title": {
      "comment": "Heading of the screen with the user's own invite link and QR code.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlekkurinn þinn"
          }
        }
      }
    },
    "invite_link_hint": {
      "comment": "Explains what the invite link does.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýndu kóðann eða deildu hlekknum. Sá sem opnar hann getur hafið samtal við þig."
          }
        }
      }
    },
    "invite_link_rotate": {
      "comment": "Replace the invite link; the old one stops working.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búa til nýjan hlekk"
          }
        }
      }
    },
    "link_invited_by": {
      "comment": "Heading of the invite link page (/l/{token}) and of the app's invite screen when a person sent the link (docs/decisions/0019).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ býður þér á Hjal."
          }
        }
      }
    },
    "link_invited": {
      "comment": "Heading of the invite link page and of the app's invite screen when the operator sent the link, or the inviter has no name.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þér er boðið á Hjal."
          }
        }
      }
    },
    "link_expired": {
      "comment": "The invite link page and the app's invite screen for a link that was rotated, revoked or never existed.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi hlekkur er ekki lengur í gildi. Biddu um nýjan."
          }
        }
      }
    },
    "update_required_title": {
      "comment": "Heading of the screen shown once the server no longer serves this build (docs/decisions/0030).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppfærsla nauðsynleg"
          }
        }
      }
    },
    "update_required_body": {
      "comment": "The update screen: this build is too old, and installing the newest one lets the person go on.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi útgáfa er orðin of gömul. Sæktu nýjustu útgáfuna til að halda áfram."
          }
        }
      }
    },
    "update_required_action": {
      "comment": "Button on the update screen that opens the app's store page.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppfæra"
          }
        }
      }
    },
    "new_group": {
      "comment": "Action that starts a new group.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýr hópur"
          }
        }
      }
    },
    "group_member_count": {
      "comment": "Members in a group.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld meðlimur"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld meðlimir"
                }
              }
            }
          }
        }
      }
    },
    "attach": {
      "comment": "Attach a photo or file to a message.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hengja við"
          }
        }
      }
    },
    "attachment_remove": {
      "comment": "Removes the photo or file waiting above the composer; nothing is sent (docs/decisions/0048).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjarlægja viðhengi"
          }
        }
      }
    },
    "caption_placeholder": {
      "comment": "The empty composer while a photo or file waits above it; its text is sent as the caption (docs/decisions/0048).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bæta við texta…"
          }
        }
      }
    },
    "attachment_pending_photo": {
      "comment": "Screen reader label of the photo waiting above the composer (docs/decisions/0048).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mynd tilbúin til sendingar"
          }
        }
      }
    },
    "attachment_pending_file": {
      "comment": "Screen reader label of the file waiting above the composer; name is the file's name (docs/decisions/0048).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrá tilbúin til sendingar: %1$@"
          }
        }
      }
    },
    "camera": {
      "comment": "Composer button that takes a photo with the system camera (docs/decisions/0047).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Taka mynd"
          }
        }
      }
    },
    "camera_usage": {
      "comment": "Why the app asks for the camera, shown by iOS in its permission prompt (NSCameraUsageDescription, docs/decisions/0047).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndavélin er notuð til að taka mynd sem þú sendir í samtali."
          }
        }
      }
    },
    "location": {
      "comment": "A location message (docs/decisions/0059): the attach menu's choice, the card's heading, the conversation list's last line, a quote of one and a notification. Never the place itself.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðsetning"
          }
        }
      }
    },
    "location_coordinates": {
      "comment": "The place on a location card, in degrees with the decimal comma; latitude and longitude are location_north/location_south and location_east/location_west (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "location_north": {
      "comment": "A latitude north of the equator; degrees is like 64,14196 (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@° N"
          }
        }
      }
    },
    "location_south": {
      "comment": "A latitude south of the equator (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@° S"
          }
        }
      }
    },
    "location_east": {
      "comment": "A longitude east of Greenwich (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@° A"
          }
        }
      }
    },
    "location_west": {
      "comment": "A longitude west of Greenwich (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@° V"
          }
        }
      }
    },
    "location_accuracy": {
      "comment": "How close the fix is, in whole metres, on the card and in the send dialog (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákvæmni um %1$lld m"
          }
        }
      }
    },
    "location_send_title": {
      "comment": "Heading of the dialog that asks before a location is sent; its buttons are send and cancel (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Senda staðsetninguna þína?"
          }
        }
      }
    },
    "location_finding": {
      "comment": "While the phone takes a fresh fix, for up to 30 seconds (docs/decisions/0059).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leita að staðsetningu"
          }
        }
      }
    },

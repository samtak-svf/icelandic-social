        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðfestu hver þú ert með rafrænum skilríkjum. Þá birtist skjöldur við nafnið þitt og aðrir vita að nafnið er rétt."
          }
        }
      }
    },
    "verify_point_name": {
      "comment": "Verify screen: the registry name replaces the account's name.",

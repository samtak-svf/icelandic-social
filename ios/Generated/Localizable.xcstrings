      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafnið þitt verður nafnið sem stendur í Þjóðskrá."
          }
        }
      }
    },
    "verify_point_kennitala": {
      "comment": "Verify screen: the kennitala is kept only as an HMAC (docs/decisions/0019).",

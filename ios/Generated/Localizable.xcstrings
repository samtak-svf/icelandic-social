{
  "sourceLanguage": "is",
  "strings": {
    "app_name": {
      "comment": "Launcher label, home-screen name, store-facing display name.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjal"
          }
        }
      }
    },
    "tab_conversations": {
      "comment": "Bottom tab: the conversation list.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjal"
          }
        }
      }
    },
    "tab_me": {
      "comment": "Bottom tab: own profile and settings.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég"
          }
        }
      }
    },
    "new_conversation": {
      "comment": "Action that starts a new conversation.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýtt hjal"
          }
        }
      }
    },
    "conversations_empty": {
      "comment": "The conversation list when there is none yet; points at the invite link (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin samtöl enn. Deildu hlekknum þínum til að hefja samtal."
          }
        }
      }
    },
    "people_empty": {
      "comment": "The new-conversation picker when the person has met nobody yet; points at the invite link (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hér birtist fólk sem þú hefur spjallað við. Deildu hlekknum þínum til að hefja fyrsta samtalið."
          }
        }
      }
    },
    "connection_offline": {
      "comment": "Line on the conversation list while the app has no connection to the server (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert samband. Skilaboð berast þegar sambandið kemst aftur á."
          }
        }
      }
    },
    "connection_connecting": {
      "comment": "Line on the conversation list while the app reconnects.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengist…"
          }
        }
      }
    },
    "conversation_removed_banner": {
      "comment": "Banner in a conversation this account was removed from; the conversation is read-only (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú ert ekki lengur í þessu samtali."
          }
        }
      }
    },
    "conversation_alone_banner": {
      "comment": "Banner in a conversation no other account is in any more, as a 1:1 after a block; nothing can be sent there (docs/decisions/0024).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins þú ert eftir í þessu samtali."
          }
        }
      }
    },
    "conversation_alone_title": {
      "comment": "Title of a conversation no other account is in any more; a conversation is otherwise titled by its members (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins þú"
          }
        }
      }
    },
    "conversation_excluded_banner": {
      "comment": "Banner in a conversation the server refuses this device for; read-only until the next try (docs/decisions/0020, 0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki fær ekki aðgang að samtalinu eins og er. Reynt verður aftur."
          }
        }
      }
    },
    "conversation_stale_banner": {
      "comment": "Banner while this device rejoins a conversation it fell behind in (docs/decisions/0021, 0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalið er að tengjast aftur. Það gæti vantað skilaboð sem bárust á meðan."
          }
        }
      }
    },
    "contact_action": {
      "comment": "Button on an invite landing that opens a conversation with the inviter.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjala"
          }
        }
      }
    },
    "invite": {
      "comment": "Share your own invite link or QR code (docs/decisions/0009).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjóða"
          }
        }
      }
    },
    "composer_placeholder": {
      "comment": "Empty message composer.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifaðu skilaboð…"
          }
        }
      }
    },
    "send": {
      "comment": "Send button.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Senda"
          }
        }
      }
    },
    "message_sending": {
      "comment": "Status of an own message that is still being sent.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í sendingu"
          }
        }
      }
    },
    "message_failed": {
      "comment": "Status of an own message that could not be sent; the bubble offers try_again.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki send."
          }
        }
      }
    },
    "day_today": {
      "comment": "Day separator for today's messages.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í dag"
          }
        }
      }
    },
    "day_yesterday": {
      "comment": "Day separator for yesterday's messages.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í gær"
          }
        }
      }
    },
    "verified_with_kennitala": {
      "comment": "Badge on a person verified through Kenni.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðfest með kennitölu"
          }
        }
      }
    },
    "unread_count": {
      "comment": "Unread messages in a conversation.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld ólesin"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld ólesin"
                }
              }
            }
          }
        }
      }
    },
    "push_fallback_body": {
      "comment": "Notification text when the device could not fetch what a push announced: the APNs alert the notification service extension keeps when it cannot decrypt in time, and Android's when its sync fails (docs/decisions/0025). Never names the sender.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ný skilaboð á Hjal"
          }
        }
      }
    },
    "notifications_off": {
      "comment": "Row on Ég when the system blocks the app's notifications: new messages are not announced until it is opened (docs/decisions/0025).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slökkt er á tilkynningum. Þú sérð ekki ný skilaboð fyrr en þú opnar appið."
          }
        }
      }
    },
    "notifications_settings": {
      "comment": "Action on the notifications_off row: opens the app's notification settings in the system.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opna stillingar"
          }
        }
      }
    },
    "new_device_card": {
      "comment": "System card in a conversation when a member adds a device (from an MLS add commit).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tengdi nýtt tæki."
          }
        }
      }
    },
    "member_added_card": {
      "comment": "System card when an account joins a group (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bættist í hópinn."
          }
        }
      }
    },
    "member_removed_card": {
      "comment": "System card when an account leaves a group, is removed, or deletes its account (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er ekki lengur í hópnum."
          }
        }
      }
    },
    "member_removed_card_direct": {
      "comment": "System card in a 1:1 when the other account leaves it, as on a block; member_removed_card says the same of a group (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er ekki lengur í samtalinu."
          }
        }
      }
    },
    "history_device_local_notice": {
      "comment": "Explains that a new device sees only messages sent after it joined (docs/decisions/0006).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ný tæki sjá aðeins skilaboð sem berast eftir að þau tengjast. Eldri skilaboð eru áfram á tækjunum sem tóku við þeim."
          }
        }
      }
    },
    "invite_link_title": {
      "comment": "Heading of the screen with the user's own invite link and QR code.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlekkurinn þinn"
          }
        }
      }
    },
    "invite_link_hint": {
      "comment": "Explains what the invite link does.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýndu kóðann eða deildu hlekknum. Sá sem opnar hann getur hafið samtal við þig."
          }
        }
      }
    },
    "invite_link_rotate": {
      "comment": "Replace the invite link; the old one stops working.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búa til nýjan hlekk"
          }
        }
      }
    },
    "invite_required": {
      "comment": "Shown after Kenni sign-in without a valid invite during the closed test (docs/decisions/0009).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjal er í lokuðum prófunum. Þú þarft hlekk frá einhverjum sem er þegar á Hjal."
          }
        }
      }
    },
    "link_invited_by": {
      "comment": "Heading of the invite link page (/l/{token}) and of the app's invite screen when a person sent the link (docs/decisions/0019).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ býður þér á Hjal."
          }
        }
      }
    },
    "link_invited": {
      "comment": "Heading of the invite link page and of the app's invite screen when the operator sent the link, or the inviter has no name.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þér er boðið á Hjal."
          }
        }
      }
    },
    "link_expired": {
      "comment": "The invite link page and the app's invite screen for a link that was rotated, revoked or never existed.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi hlekkur er ekki lengur í gildi. Biddu um nýjan."
          }
        }
      }
    },
    "new_group": {
      "comment": "Action that starts a new group.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýr hópur"
          }
        }
      }
    },
    "group_member_count": {
      "comment": "Members in a group.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld meðlimur"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld meðlimir"
                }
              }
            }
          }
        }
      }
    },
    "attach": {
      "comment": "Attach a photo or file to a message.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hengja við"
          }
        }
      }
    },
    "person_unnamed": {
      "comment": "Stands in for an account whose name the server has not given, in titles and rows (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafnlaus"
          }
        }
      }
    },
    "photo": {
      "comment": "Label of a photo message, in the conversation list and for screen readers.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mynd"
          }
        }
      }
    },
    "file": {
      "comment": "Label of a file message, in the conversation list and for screen readers.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrá"
          }
        }
      }
    },
    "media_too_large": {
      "comment": "A chosen photo or file is over the limit (docs/decisions/0023).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráin er of stór. Hámarkið er 25 MB."
          }
        }
      }
    },
    "media_download_failed": {
      "comment": "A photo or file could not be fetched or did not match its checksum; the bubble offers try_again.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að sækja skrána. Reyndu aftur."
          }
        }
      }
    },
    "file_no_app": {
      "comment": "A received file was opened, but no app on the device opens its type.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert forrit í tækinu getur opnað þessa skrá."
          }
        }
      }
    },
    "reply": {
      "comment": "Quote-reply to a message.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara"
          }
        }
      }
    },
    "edit": {
      "comment": "Edit an own message.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Breyta"
          }
        }
      }
    },
    "edited_marker": {
      "comment": "Marker on a message that was edited.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "breytt"
          }
        }
      }
    },
    "delete_for_everyone": {
      "comment": "Delete an own message on every member's devices.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Taka til baka"
          }
        }
      }
    },
    "delete_confirm": {
      "comment": "Confirmation before deleting an own message for everyone.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Taka skilaboðin til baka? Þau hverfa úr tækjum allra í samtalinu."
          }
        }
      }
    },
    "message_deleted": {
      "comment": "Tombstone left where a deleted message was.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skilaboðin voru tekin til baka."
          }
        }
      }
    },
    "react": {
      "comment": "Add a reaction to a message.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bregðast við"
          }
        }
      }
    },
    "disappearing_messages": {
      "comment": "Per-conversation setting: messages delete themselves after a set time.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímabundin skilaboð"
          }
        }
      }
    },
    "disappearing_set_card": {
      "comment": "System card when a member sets the disappearing timer; duration is formatted by the client.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stillti á að skilaboð hverfi eftir %2$@."
          }
        }
      }
    },
    "disappearing_off_card": {
      "comment": "System card when a member turns the disappearing timer off.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slökkti á tímabundnum skilaboðum."
          }
        }
      }
    },
    "disappearing_off": {
      "comment": "Timer option: messages do not disappear.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slökkt"
          }
        }
      }
    },
    "disappearing_option": {
      "comment": "Timer option label; duration is one of the duration keys below (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftir %1$@"
          }
        }
      }
    },
    "duration_hours": {
      "comment": "A duration in hours, in the form that follows \"eftir\" in disappearing_set_card and disappearing_option.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld klukkustund"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld klukkustundir"
                }
              }
            }
          }
        }
      }
    },
    "duration_days": {
      "comment": "A duration in days, in the form that follows \"eftir\" in disappearing_set_card and disappearing_option.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld dag"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld daga"
                }
              }
            }
          }
        }
      }
    },
    "read_marker": {
      "comment": "Marker on an own message the other party has read.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesin"
          }
        }
      }
    },
    "read_by_count": {
      "comment": "Under an own message in a group: how many members have read it (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld hefur lesið"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld hafa lesið"
                }
              }
            }
          }
        }
      }
    },
    "read_receipts_setting": {
      "comment": "Toggle in Me: send read markers.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Láta vita þegar ég les"
          }
        }
      }
    },
    "read_receipts_hint": {
      "comment": "Explains that the read-marker toggle is reciprocal.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú slekkur á þessu sérð þú heldur ekki hvenær aðrir lesa."
          }
        }
      }
    },
    "typing_setting": {
      "comment": "Toggle in Me: send typing indicators.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýna þegar ég skrifa"
          }
        }
      }
    },
    "typing_indicator": {
      "comment": "Shown while another member is typing.",
      "extractionState": "manual",
      "localizations": {
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er að skrifa…"
          }
        }
      }
    },
    "typing_indicator_group": {
      "comment": "Shown while a member of a group is typing; a group's typing frame does not prove who sent it, so it names no one (docs/decisions/0022).",
      "extractionState": "manual",
      "localizations": {
        "is": {

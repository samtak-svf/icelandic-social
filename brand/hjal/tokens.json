  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Gothic A1", "sans-serif"] },
    "headline": {
      "$value": ["Archivo Condensed", "sans-serif"],
      "$description": "Weight 800, condensed name headers."
    }
  },
  "type": {

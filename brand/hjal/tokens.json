{
  "$description": "Hjal design tokens, DTCG format (designtokens.org, 2025.10). Colours are the Samtak design system v10 values (samtak-vefur apps/web/src/styles.css, approved 17.07), which the Hjal option board builds on. Contrast is computed by tooling/brand-check.mjs against brand/contrast-pairs.json; a brand that fails does not generate.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": { "colorSpace": "oklch", "components": [0.9453, 0.0324, 64.44] },
      "$description": "Cream band: headers, the account screen."
    },
    "surface": {
      "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
      "$description": "Screen background."
    },
    "fg": {
      "$value": { "colorSpace": "oklch", "components": [0.17, 0.03, 145] },
      "$description": "Text on light, black-green."
    },
    "primary": {
      "$value": { "colorSpace": "oklch", "components": [0.49, 0.19, 32] },
      "$description": "Brick red: main action, own bubble."
    },
    "primary-fg": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
    "secondary": {
      "$value": { "colorSpace": "oklch", "components": [0.7704, 0.144, 71.22] },
      "$description": "Gold: accents and rules. Decorative; see verified-mark for the meaning-bearing gold."
    },
    "secondary-fg": { "$value": "{color.fg}" },
    "prose-body": { "$value": { "colorSpace": "oklch", "components": [0.28, 0.037, 260] } },
    "muted": {
      "$value": { "colorSpace": "oklch", "components": [0.92, 0.015, 64.44] },
      "$description": "Quiet fills: the other party's bubble, the composer field, icon wells."
    },
    "muted-fg": { "$value": { "colorSpace": "oklch", "components": [0.51, 0.04, 260] } },
    "primary-subtle": {
      "$value": { "colorSpace": "oklch", "components": [0.49, 0.19, 32], "alpha": 0.12 },
      "$description": "Wash behind an unread conversation."
    },
    "secondary-subtle": {
      "$value": { "colorSpace": "oklch", "components": [0.7704, 0.144, 71.22], "alpha": 0.15 },
      "$description": "Wash behind a group avatar, a notice and the this-device pill."
    },
    "border": {
      "$value": { "colorSpace": "oklch", "components": [0.17, 0.03, 145], "alpha": 0.18 },
      "$description": "Decorative dividers only."
    },
    "border-strong": {
      "$value": { "colorSpace": "oklch", "components": [0.17, 0.03, 145], "alpha": 0.5 },
      "$description": "Boundaries that identify a control."
    },
    "danger": {
      "$value": { "colorSpace": "oklch", "components": [0.48, 0.2, 20] },
      "$description": "Crimson: destructive actions and failures. Hue 20 against primary's 32, so blocking or deleting never looks like the main action; brand-check holds the distance."
    },
    "danger-fg": { "$value": "{color.primary-fg}" },
    "success": { "$value": { "colorSpace": "oklch", "components": [0.5933, 0.1189, 164.8] } },
    "warning": { "$value": { "colorSpace": "oklch", "components": [0.7455, 0.19, 48] } },
    "warning-fg": { "$value": "{color.fg}" },
    "info": { "$value": { "colorSpace": "oklch", "components": [0.5971, 0.1459, 247.7] } },
    "success-text": { "$value": { "colorSpace": "oklch", "components": [0.49, 0.1189, 164.8] } },
    "warning-text": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.19, 48] } },
    "info-text": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.1459, 247.7] } },
    "bubble-own-bg": { "$value": "{color.primary}" },
    "bubble-own-fg": { "$value": "{color.primary-fg}" },
    "bubble-other-bg": { "$value": "{color.muted}" },
    "bubble-other-fg": { "$value": "{color.fg}" },
    "verified-mark": {
      "$value": { "colorSpace": "oklch", "components": [0.6, 0.144, 71.22] },
      "$description": "The verification dot. Same hue and chroma as secondary, lightness lowered until it meets the 3:1 non-text threshold (WCAG 1.4.11) on surface and bg, because the dot carries meaning."
    }
  },

{
  // The Worker. Imports carry their `.ts` extension so scripts/openapi.ts can
  // load src/ under plain `node`; cf's bundler accepts them too.
  // `.cloudflare/types/index.d.ts` is generated by `cf workers types`, not committed.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["./.cloudflare/types/index.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "test", "dev", "vitest.config.ts", "cloudflare.config.ts"]
}

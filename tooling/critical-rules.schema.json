{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Shape of tooling/critical-rules.json (docs/testing.md § Critical rules).",
  "type": "object",
  "required": ["rules", "retired"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "decision", "rule", "tests"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "domain": { "enum": ["crypto", "sign-in", "pii", "privacy", "residency", "delivery"] },
          "decision": { "type": "string", "pattern": "^[0-9]{4}$" },
          "rule": { "type": "string", "minLength": 10 },
          "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
          "gap": { "type": "string", "pattern": "^#[0-9]+$" }
        }
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "name", "reason"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "name": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": ["file", "name"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "\\.(ts|mjs|rs|kt|swift)$" },
        "name": { "type": "string", "minLength": 3 },
        "caught": { "type": "string", "pattern": "^(#[0-9]+|[0-9a-f]{7,40})$" }
      }
    }
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tooling/*.mjs", "tooling/tests/**/*.test.mjs"],
      "project": ["tooling/**/*.mjs"],
      "ignoreBinaries": ["gcloud", "cf"]
    },
    "backend": {
      "entry": ["src/index.ts", "scripts/*.ts", "test/worker.ts", "dev/worker.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "dev/**/*.ts"],
      "ignoreDependencies": ["cloudflare", "@tanstack/react-router", "react", "react-dom"]
    },
    "spikes/browser-storage": {
      "entry": ["*.mjs", "page/bench.js", "page/a-worker.js"],
      "project": ["*.mjs", "page/*.js"]
    },
    "web": {
      "entry": ["src/routes/**/*.tsx", "src/generated/api.ts"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}

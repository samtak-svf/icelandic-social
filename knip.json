{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tooling/*.mjs", "tooling/tests/**/*.test.mjs"],
      "project": ["tooling/**/*.mjs"],
      "ignoreBinaries": ["gcloud", "cf"]
    },
    "backend": {
      "entry": ["scripts/*.ts", "test/worker.ts", "dev/worker.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "dev/**/*.ts"],
      "ignoreDependencies": ["cloudflare", "wrangler"]
    }
  }
}

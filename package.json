{
  "name": "samtak-spjall",
  "private": true,
  "description": "Repo-wide tooling: frozen ids, brand pipeline, guards and the contract emitters. The root of the pnpm workspace; the Worker is the package in backend/.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run check:ids && pnpm run check:critical-rules && pnpm run check:quarantine && pnpm run check:brand && pnpm run check:brand-gen && pnpm run check:brand-leak && pnpm run check:thankastrik && pnpm run check:pii && pnpm run check:seams && pnpm run check:jurisdiction && pnpm run check:core && pnpm run check:ws-kotlin && pnpm run check:workflows && pnpm run knip",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:ids": "node tooling/ids-freeze.mjs",
    "check:critical-rules": "node tooling/critical-rules.mjs",
    "check:quarantine": "node tooling/quarantine.mjs",
    "check:brand": "node tooling/brand-check.mjs",
    "brand:gen": "node tooling/brand-gen.mjs",
    "check:brand-gen": "node tooling/brand-gen.mjs --check",
    "check:brand-leak": "node tooling/brand-leak-guard.mjs",
    "check:thankastrik": "node tooling/thankastrik.mjs",
    "check:pii": "node tooling/pii-guard.mjs",
    "check:seams": "node tooling/seam-guard.mjs",
    "check:jurisdiction": "node tooling/jurisdiction-check.mjs",
    "check:core": "node tooling/core-guard.mjs",
    "check:ws-kotlin": "node tooling/ws-kotlin.mjs --check",
    "check:workflows": "node tooling/workflow-guard.mjs",
    "knip": "knip",
    "test": "vitest run"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26",
    "ajv": "^8",
    "knip": "^6",
    "lefthook": "^2",
    "oxfmt": "^0.72",
    "oxlint": "^1",
    "typescript": "^7",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=24.2"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "undici@<7.29.1": "^7.29.1",
      "sharp@<0.35.5": "^0.35.5"
    }
  }
}

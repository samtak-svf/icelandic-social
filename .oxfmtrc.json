{
  "$schema": "https://oxc.rs/schemas/oxfmt.json",
  // identifiers/ids.lock.json is formatted like ids.json, which keeps the two
  // byte-identical as tooling/ids-freeze.mjs requires. pnpm owns its own lock.
  // api/openapi.json is written by backend/scripts/openapi.ts and ios/Generated/
  // and web/src/generated/ by tooling/brand-gen.mjs; all are drift-checked byte for byte, so the
  // generator's layout is the one that counts.
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/*.gen.ts",
    "api/openapi.json",
    "ios/Generated/**",
    "web/src/generated/**"
  ],
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "quoteStyle": "double",
  "semicolons": true,
  "trailingCommas": "all"
}
